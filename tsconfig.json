{
  "compilerOptions": {
    "declaration": true,
    "target": "es2019",
    "lib": [
      "es2019",
      "esnext.weakref",
      "es2021.intl",
      "dom",
      "dom.iterable"
    ],
    "module": "commonjs",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "mocha",
      "chai",
      "chai-as-promised",
      "dirty-chai"
    ]
  },
  "exclude": ["dist", "main", "renderer"]
}
